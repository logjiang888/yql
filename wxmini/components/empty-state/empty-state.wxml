<view class="empty-state">
  <view class="empty-icon">
    <image src="/assets/empty.png" mode="aspectFit" wx:if="{{false}}"></image>
    <view class="empty-placeholder">
      <view class="empty-box">
        <view class="empty-box-inner"></view>
      </view>
    </view>
  </view>
  <view class="empty-title">{{title}}</view>
  <view class="empty-desc" wx:if="{{desc}}">{{desc}}</view>
  <view class="empty-btn" wx:if="{{showBtn}}" bindtap="onTap">{{btnText}}</view>
</view>
