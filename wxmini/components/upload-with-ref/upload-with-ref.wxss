.upload-wrap {
  margin-bottom: 24rpx;
}

.upload-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  padding: 0 32rpx;
}

.upload-ref-btn {
  display: flex;
  align-items: center;
  margin-left: auto;
  padding: 8rpx 16rpx;
  background-color: var(--primary-light);
  border-radius: var(--radius-md);
}

.ref-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.ref-text {
  font-size: 24rpx;
  color: var(--primary);
}

.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 32rpx;
  padding-left: 88rpx;
}

.upload-file {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.upload-file-img {
  width: 100%;
  height: 100%;
}

.upload-file-del {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: var(--danger);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.del-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1;
}

.upload-box {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-md);
  background-color: #FAFAFA;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-box-icon {
  font-size: 48rpx;
  color: var(--text-tertiary);
  line-height: 1;
  margin-bottom: 8rpx;
}

.upload-box-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
}
