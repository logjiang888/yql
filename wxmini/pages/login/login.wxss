.login-header {
  padding: 60rpx 32rpx 32rpx;
}

.login-title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--van-text-color);
  margin-bottom: 16rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: var(--van-text-color-2);
}

/* 用户类型选择 */
.type-section {
  margin: 0 32rpx 32rpx;
}

.type-grid {
  display: flex;
  gap: 20rpx;
}

.type-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #fff;
  border: 2rpx solid #ebedf0;
  border-radius: 16rpx;
  padding: 24rpx 0;
  transition: all 0.2s;
}

.type-card:active {
  opacity: 0.8;
}

.type-active {
  background-color: #2563EB;
  border-color: #2563EB;
}

.type-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}

.type-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #323233;
  margin-bottom: 4rpx;
}

.type-active .type-name {
  color: #fff;
}

.type-desc {
  font-size: 20rpx;
  color: #999;
}

.type-active .type-desc {
  color: rgba(255, 255, 255, 0.8);
}

/* 登录方式切换 */
.login-tabs {
  margin: 0 32rpx 32rpx;
}

.field-item {
  background-color: var(--van-background-color);
  border-radius: var(--van-radius-lg, 16rpx);
  padding: 20rpx 24rpx !important;
  margin-bottom: 24rpx;
}

.code-btn {
  height: 56rpx !important;
  line-height: 56rpx !important;
  font-size: 24rpx !important;
}

.error-msg {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--van-danger-color);
  margin-top: 8rpx;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.forgot-link {
  text-align: right;
  font-size: 26rpx;
  color: var(--van-primary-color);
  margin-bottom: 48rpx;
}

.login-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  padding: 48rpx 0 calc(48rpx + env(safe-area-inset-bottom));
  font-size: 28rpx;
}
