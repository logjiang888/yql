.login-header {
  padding: 80rpx 32rpx 48rpx;
}

.login-title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--van-text-color);
  margin-bottom: 16rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: var(--van-text-color-2);
}

.login-tabs {
  margin: 0 32rpx 32rpx;
}

.field-item {
  background-color: var(--van-background-color);
  border-radius: var(--van-radius-lg, 16rpx);
  padding: 20rpx 24rpx !important;
  margin-bottom: 24rpx;
}

.code-btn {
  height: 56rpx !important;
  line-height: 56rpx !important;
  font-size: 24rpx !important;
}

.error-msg {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--van-danger-color);
  margin-top: 8rpx;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.forgot-link {
  text-align: right;
  font-size: 26rpx;
  color: var(--van-primary-color);
  margin-bottom: 48rpx;
}

.login-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  padding: 48rpx 0 calc(48rpx + env(safe-area-inset-bottom));
  font-size: 28rpx;
}
