<view class="page-white">
  <!-- 顶部标题 -->
  <view class="login-header">
    <view class="login-title">欢迎回到{{appName}}</view>
    <view class="login-subtitle">请选择用户类型并登录</view>
  </view>

  <!-- 用户类型选择 -->
  <view class="type-section">
    <view class="type-grid">
      <view
        class="type-card {{ role === 'company' ? 'type-active' : '' }}"
        data-role="company"
        bindtap="onRoleChange"
      >
        <view class="type-icon">🏢</view>
        <view class="type-name">企业主</view>
        <view class="type-desc">贷款需求方</view>
      </view>
      <view
        class="type-card {{ role === 'bank' ? 'type-active' : '' }}"
        data-role="bank"
        bindtap="onRoleChange"
      >
        <view class="type-icon">🏦</view>
        <view class="type-name">银行人员</view>
        <view class="type-desc">贷款提供方</view>
      </view>
      <view
        class="type-card {{ role === 'plat_salesperson' ? 'type-active' : '' }}"
        data-role="plat_salesperson"
        bindtap="onRoleChange"
      >
        <view class="type-icon">🤝</view>
        <view class="type-name">平台客服</view>
        <view class="type-desc">平台方</view>
      </view>
    </view>
  </view>

  <!-- 登录方式切换 -->
  <van-tabs
    active="{{ loginType }}"
    bind:change="onSwitchType"
    color="#2563EB"
    line-width="32"
    class="login-tabs"
  >
    <van-tab title="密码登录" name="password"></van-tab>
    <van-tab title="验证码登录" name="code"></van-tab>
  </van-tabs>

  <!-- 表单 -->
  <view class="px-lg">
    <van-cell-group border="{{ false }}">
      <van-field
        value="{{ phone }}"
        label="手机号"
        placeholder="请输入手机号"
        type="number"
        maxlength="11"
        border="{{ false }}"
        error="{{ errorField === 'phone' }}"
        data-field="phone"
        bind:input="onInputChange"
        custom-class="field-item"
        left-icon="phone-o"
      />

      <van-field
        wx:if="{{ loginType === 'code' }}"
        value="{{ code }}"
        label="验证码"
        placeholder="请输入验证码"
        type="number"
        maxlength="6"
        border="{{ false }}"
        error="{{ errorField === 'code' }}"
        data-field="code"
        bind:input="onInputChange"
        custom-class="field-item"
        left-icon="shield-o"
        use-button-slot
      >
        <van-button
          slot="button"
          size="small"
          type="primary"
          plain
          disabled="{{ countdown > 0 }}"
          bind:click="onSendCode"
          custom-class="code-btn"
        >
          {{ countdown > 0 ? countdown + 's' : '获取验证码' }}
        </van-button>
      </van-field>

      <van-field
        wx:if="{{ loginType === 'password' }}"
        value="{{ password }}"
        label="密码"
        placeholder="请输入密码"
        password="{{ !showPassword }}"
        border="{{ false }}"
        error="{{ errorField === 'password' }}"
        data-field="password"
        bind:input="onInputChange"
        custom-class="field-item"
        left-icon="lock"
        right-icon="{{ showPassword ? 'closed-eye' : 'eye-o' }}"
        bind:click-icon="onTogglePassword"
      />
    </van-cell-group>

    <view class="error-msg" wx:if="{{ errorMsg }}">
      <van-icon name="warning-o" color="#ee0a24" size="28rpx" class="mr-xs" />
      {{ errorMsg }}
    </view>

    <view class="forgot-link" wx:if="{{ loginType === 'password' }}" bindtap="onTapForgot">
      忘记密码？
    </view>

    <van-button
      type="primary"
      block
      round
      size="large"
      bind:click="onLogin"
      custom-class="mt-xl"
    >登录</van-button>
  </view>

  <view class="login-footer">
    <text class="text-secondary">还没有账号？</text>
    <text class="text-primary" bindtap="onTapRegister">立即注册</text>
  </view>
</view>

<van-toast id="van-toast" />
