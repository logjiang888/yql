.page-container {
  min-height: 100vh;
  background-color: #F3F4F6;
  padding-bottom: 160rpx;
}

.loading-center {
  padding-top: 200rpx;
}

.detail-header {
  background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 40rpx;
}

.detail-avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 600;
  color: #fff;
}

.detail-avatar-default {
  background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
  color: #2563eb;
}

.detail-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  margin-top: 20rpx;
  margin-bottom: 12rpx;
}

.detail-status {
  margin-bottom: 12rpx;
}

.detail-role {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.card-section {
  padding: 24rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--van-text-color);
  margin-bottom: 20rpx;
  padding-left: 32rpx;
  position: relative;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background-color: var(--van-primary-color);
  border-radius: 4rpx;
}

.product-text {
  font-size: 28rpx;
  color: var(--van-text-color-2);
  line-height: 1.6;
  padding: 0 32rpx;
}

.flex {
  display: flex;
}

.flex-wrap {
  flex-wrap: wrap;
}

.gap-sm {
  gap: 16rpx;
}

.mx-md {
  margin-left: 24rpx;
  margin-right: 24rpx;
}

.mt-md {
  margin-top: 24rpx;
}

.mb-xl {
  margin-bottom: 40rpx;
}

.fixed-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  border-top: 2rpx solid var(--van-border-color);
  z-index: 100;
}

.attach-group {
  margin-bottom: 32rpx;
}

.attach-group:last-child {
  margin-bottom: 0;
}

.attach-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--van-text-color);
  margin-bottom: 16rpx;
  padding-left: 32rpx;
}

.attach-empty {
  font-size: 26rpx;
  color: var(--van-gray-5, #c8c9cc);
  padding-left: 32rpx;
  margin-bottom: 12rpx;
}

.ref-image-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
  padding-left: 32rpx;
}

.ref-image-text {
  font-size: 26rpx;
  color: var(--van-primary-color, #1989fa);
}
