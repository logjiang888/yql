<view class="page-container">
  <van-search
    value="{{ keyword }}"
    placeholder="搜索网点名称、区域"
    bind:change="onSearchInput"
    background="#fff"
  />

  <!-- 列表模式 -->
  <block>
    <view class="card-list">
      <skeleton-list count="5" wx:if="{{loading && list.length === 0}}"></skeleton-list>

      <block wx:elif="{{list.length > 0}}">
        <view
          class="branch-card"
          wx:for="{{list}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onItemTap"
        >
          <view class="card-header">
            <view class="branch-name">{{item.bank_name}}</view>
          </view>
          <view class="card-body">
            <view class="info-row-branch">
              <van-icon name="location-o" size="14px" color="#9CA3AF" />
              <text class="info-text">{{item.address || '暂无地址信息'}}</text>
            </view>
            <view class="info-row-branch">
              <van-icon name="phone-o" size="14px" color="#9CA3AF" />
              <text class="info-text">{{item.phone || '-'}}</text>
            </view>
            <view class="info-row-branch">
              <van-icon name="label-o" size="14px" color="#9CA3AF" />
              <text class="info-text">{{item.bank_code || '-'}}</text>
            </view>
          </view>
          <view class="card-footer">
            <van-button size="small" plain hairline round bind:click="onNavigate"
              data-lat="{{item.latitude}}" data-lng="{{item.longitude}}" data-name="{{item.bank_name}}"
            >导航</van-button>
            <van-button size="small" type="primary" plain round bind:click="onItemTap"
              data-id="{{item.id}}"
            >详情</van-button>
          </view>
        </view>

        <load-more status="{{loadStatus}}"></load-more>
      </block>

      <empty-state wx:else title="暂无网点信息" desc="" bindretry="loadList"></empty-state>
    </view>
  </block>
</view>
