.card-list {
  padding: 24rpx;
}

.branch-card {
  background-color: #fff;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.15s ease;
}

.branch-card:active {
  transform: scale(0.98);
}

.branch-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--van-text-color);
  margin-bottom: 16rpx;
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.info-row-branch {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.info-text {
  font-size: 26rpx;
  color: var(--van-text-color-2);
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--van-border-color);
}

.map-container {
  position: relative;
  height: calc(100vh - 200rpx);
}

.map {
  width: 100%;
  height: 100%;
}
