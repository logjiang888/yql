.remark-page {
  min-height: 100vh;
  background-color: var(--background);
  padding: 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.remark-company {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 40rpx;
}

.form-section {
  margin-bottom: 40rpx;
}

.form-label {
  font-size: 30rpx;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  font-weight: 500;
}

.type-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.type-tag {
  padding: 16rpx 32rpx;
  background-color: #F3F4F6;
  color: #6B7280;
  font-size: 28rpx;
  border-radius: 8rpx;
}

.type-tag.active {
  background-color: #DBEAFE;
  color: #2563EB;
  font-weight: 500;
}

.remark-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background-color: #fff;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.form-footer {
  margin-top: 60rpx;
}
