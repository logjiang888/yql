.start-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #2563EB 0%, #1D4ED8 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  box-sizing: border-box;
}

.start-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.start-logo {
  width: 160rpx;
  height: 160rpx;
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
}

.start-name {
  font-size: 48rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.start-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.start-card {
  width: 80%;
  max-width: 640rpx;
  background-color: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.start-card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--van-text-color);
  text-align: center;
  margin-bottom: 40rpx;
}

.role-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.role-cell {
  background-color: var(--van-background-color);
  border-radius: var(--van-radius-lg, 16rpx);
  padding: 24rpx !important;
}

.role-icon {
  width: 64rpx;
  height: 64rpx;
  background-color: var(--van-primary-color);
  border-radius: var(--van-radius-md, 8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.role-title {
  font-size: 32rpx !important;
  font-weight: 500;
  color: var(--van-text-color) !important;
}

.start-footer {
  margin-top: auto;
  padding: 48rpx 0 calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.start-footer-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.start-footer-link {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
  text-decoration: underline;
}
