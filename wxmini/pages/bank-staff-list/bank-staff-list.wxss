.page-title-bar {
  background: linear-gradient(135deg, #2563EB, #1D4ED8);
  padding: 40rpx 32rpx 32rpx;
  text-align: center;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
}

.search-filter-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  background-color: #fff;
  padding-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.filter-scroll {
  white-space: nowrap;
  padding: 0 32rpx;
}

.filter-tag {
  margin-right: 16rpx !important;
}

.filter-active {
  background-color: var(--van-primary-color) !important;
  color: #fff !important;
  border-color: var(--van-primary-color) !important;
}

.card-list {
  padding: 24rpx;
}

.staff-card {
  background-color: #fff;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: transform 0.15s ease;
}

.staff-card:active {
  transform: scale(0.98);
}

.card-main {
  display: flex;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
}

.card-info {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.staff-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--van-text-color);
  margin-right: 12rpx;
}

.info-sub {
  font-size: 26rpx;
  color: var(--van-text-color-2);
  margin-bottom: 12rpx;
}

.scope-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.card-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.action-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.15s ease;
}

.action-btn:active {
  transform: scale(0.92);
}

.btn-phone {
  background: linear-gradient(135deg, #2563EB, #3B82F6);
}

.btn-chat {
  background: linear-gradient(135deg, #10B981, #34D399);
}
