.home-bank-page {
  min-height: 100vh;
  background-color: var(--background);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.home-bank-nav {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  background-color: #fff;
  position: relative;
  min-height: 88rpx;
  box-sizing: border-box;
}

.home-bank-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  margin-top: calc(env(safe-area-inset-top) / 2);
  white-space: nowrap;
  line-height: 1;
}

.home-bank-msg {
  font-size: 40rpx;
  min-width: 120rpx;
  text-align: right;
  margin-left: auto;
  line-height: 1;
}

.overview-card {
  margin: 24rpx 32rpx;
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  color: #fff;
}

.overview-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.overview-avatar {
  width: 96rpx;
  height: 96rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.overview-avatar-img {
  display: block;
  background-color: transparent;
}

.overview-info {
  flex: 1;
}

.overview-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.overview-bank {
  font-size: 26rpx;
  opacity: 0.9;
}

.stats-card {
  display: flex;
  align-items: center;
  margin: 0 32rpx 24rpx;
  background-color: #fff;
  border-radius: var(--radius-lg);
  padding: 32rpx;
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-num {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.stats-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: var(--border);
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background-color: #fff;
  margin-bottom: 16rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.feature-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.feature-name {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  font-size: 26rpx;
  color: var(--primary);
}

/* 客户类型 TAB */
.cust-type-tabs {
  display: flex;
  padding: 0 32rpx 16rpx;
  background-color: #fff;
  gap: 16rpx;
}

.cust-tab {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  background-color: #F3F4F6;
  color: #6B7280;
  font-size: 26rpx;
  border-radius: 8rpx;
}

.cust-tab.active {
  background-color: #DBEAFE;
  color: #2563EB;
  font-weight: 500;
}

.recent-list {
  margin: 0 32rpx;
  background-color: #fff;
  border-radius: var(--radius-lg);
  padding: 16rpx 0;
}

.recent-item {
  padding: 20rpx 32rpx;
  border-bottom: 2rpx solid var(--border);
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.recent-contact {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.recent-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.recent-empty {
  padding: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.cust-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid var(--border);
  background-color: #fff;
  transition: background-color 0.15s;
}

.cust-item:last-child {
  border-bottom: none;
}

.cust-item:active {
  background-color: #F9FAFB;
}

.cust-main {
  flex: 1;
  min-width: 0;
}

.cust-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.cust-contact {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.cust-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.cust-type-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background-color: #DBEAFE;
  color: #2563EB;
  font-size: 22rpx;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.cust-level-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background-color: #FEF3C7;
  color: #D97706;
  font-size: 22rpx;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.cust-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-bottom: 4rpx;
}

.remark-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 4rpx;
  padding: 4rpx 10rpx;
  background-color: #EFF6FF;
  border-radius: 8rpx;
}

.remark-text {
  font-size: 22rpx;
  color: #2563EB;
}


