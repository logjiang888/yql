<view class="home-bank-page">
  <view class="home-bank-nav">
    <view class="home-bank-title">工作台</view>
    <view class="home-bank-msg" bindtap="onFeatureTap" data-path="/pages/message-list/message-list">💬</view>
  </view>

  <view wx:if="{{loading}}">
    <skeleton-card showImage="{{false}}"></skeleton-card>
    <skeleton-card showImage="{{false}}"></skeleton-card>
  </view>

  <block wx:else>
    <view class="overview-card">
      <view class="overview-header">
        <image wx:if="{{userInfo && userInfo.head_image}}" class="overview-avatar overview-avatar-img" src="{{userInfo.head_image}}" mode="aspectFill" />
      <view wx:else class="overview-avatar">{{(userInfo && userInfo.nickname && userInfo.nickname[0]) || '用'}}</view>
        <view class="overview-info">
          <view class="overview-name">{{(userInfo && userInfo.nickname) || (userInfo && userInfo.username) || '用户'}}</view>
          <status-tag status="{{role}}" type="role"></status-tag>
        </view>
      </view>
      <view class="overview-bank">{{role === 'bank' ? (userInfo.bank_name ? '所属银行：' + userInfo.bank_name : '所属银行') : '所属机构：' + (userInfo.org_name || '')}}</view>
    </view>

    <view class="stats-card">
      <view class="stats-item">
        <view class="stats-num">{{stats.total}}</view>
        <view class="stats-label">客户总数</view>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <view class="stats-num">{{stats.monthNew}}</view>
        <view class="stats-label">本月新增</view>
      </view>
    </view>

    <view class="section-header">
      <text class="section-title">我的客户</text>
      <text
        class="section-more"
        bindtap="onFeatureTap"
        data-path="/pages/company-list/company-list"
      >查看更多 ›</text>
    </view>

    <view class="cust-type-tabs">
      <view
        class="cust-tab {{activeCustType === item.value ? 'active' : ''}}"
        wx:for="{{custTypeTabs}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onCustTypeTabChange"
      >
        <van-icon name="{{item.icon}}" size="14px" class="tab-icon" />
        <text class="tab-text">{{item.label}}</text>
      </view>
    </view>

    <view class="recent-list">
      <view
        class="cust-item"
        wx:for="{{myCustList}}"
        wx:key="id"
        data-company-id="{{item.companyId}}"
        bindtap="onMyCustTap"
      >
        <view class="cust-main">
          <view class="cust-name">{{item.companyName}}</view>
          <view class="cust-contact">{{item.contactName}} {{item.contactPhone}}</view>
        </view>
        <view class="cust-right">
          <view class="cust-time">{{item.createdAt}}</view>
          <view class="remark-btn" catchtap="onRemarkTap"
            data-id="{{item.id}}"
            data-company-name="{{item.companyName}}"
            data-cust-type="{{item.custType}}"
            data-cust-level="{{item.custLevel}}"
            data-remark="{{item.remark}}"
          >
            <van-icon name="notes-o" size="12px" color="#2563EB" />
            <text class="remark-text">备注</text>
          </view>
        </view>
      </view>
      <view class="empty-state" wx:if="{{myCustList.length === 0}}">
        <van-empty description="暂无我的客户" />
      </view>
    </view>

    <view class="section-header">
      <text class="section-title">最近浏览</text>
      <text
        class="section-more"
        bindtap="onFeatureTap"
        data-path="/pages/company-list/company-list"
      >查看更多 ›</text>
    </view>

    <view class="recent-list">
      <van-cell
        wx:for="{{recentList}}"
        wx:key="id"
        title="{{item.company_name}}"
        label="{{item.contact_name}} {{item.contact_phone}}"
        data-id="{{item.id}}"
        bindtap="onCompanyTap"
        is-link
        border="{{ index < recentList.length - 1 }}"
      >
        <view slot="right-icon" class="text-muted text-xs">{{item._createdAtFormatted}}</view>
      </van-cell>
      <view class="empty-state" wx:if="{{recentList.length === 0}}">
        <van-empty description="暂无浏览记录" />
      </view>
    </view>
  </block>
</view>


