.home-page {
  min-height: 100vh;
  background-color: var(--background);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.home-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background-color: #fff;
}

.home-nav-city {
  font-size: 26rpx;
  color: var(--text-secondary);
  min-width: 120rpx;
}

.home-nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.home-nav-msg {
  font-size: 40rpx;
  min-width: 120rpx;
  text-align: right;
}

.home-search {
  padding: 16rpx 32rpx;
  background-color: #fff;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: var(--background);
  border-radius: var(--radius-full);
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: var(--text-tertiary);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

/* 功能入口 */
.feature-grid {
  display: flex;
  padding: 24rpx 32rpx;
  background-color: #fff;
  margin-bottom: 16rpx;
  gap: 24rpx;
}

.feature-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background-color: var(--background);
  border-radius: var(--radius-lg);
}

.feature-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.feature-name {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.banner-wrap {
  position: relative;
  margin: 0 32rpx 24rpx;
}

.banner-swiper {
  height: 320rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-dots {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 16rpx;
  height: 8rpx;
  background-color: rgba(255, 255, 255, 0.5);
  border-radius: 4rpx;
  transition: all 0.3s;
}

.dot.active {
  width: 32rpx;
  background-color: #fff;
}

/* 业务范围筛选 */
.scope-filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
  background-color: #fff;
}

.scope-filter-tag {
  padding: 8rpx 20rpx;
  background-color: #F3F4F6;
  color: #6B7280;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.scope-filter-tag.active {
  background-color: #DBEAFE;
  color: #2563EB;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  font-size: 26rpx;
  color: var(--primary);
}

/* 推荐银行人员 –垂直卡片列表 */
.staff-list {
  padding: 0 24rpx 32rpx;
}

.staff-card {
  background-color: #fff;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: transform 0.15s ease;
}

.staff-card:active {
  transform: scale(0.98);
}

.card-main {
  display: flex;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
}

.card-info {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.staff-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-right: 12rpx;
}

.info-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.scope-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.card-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.action-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.15s ease;
}

.action-btn:active {
  transform: scale(0.92);
}

.btn-phone {
  background: linear-gradient(135deg, #2563EB, #3B82F6);
}

.btn-chat {
  background: linear-gradient(135deg, #10B981, #34D399);
}

.load-more {
  text-align: center;
  padding: 24rpx 0 48rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.empty-tip {
  text-align: center;
  padding: 120rpx 32rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}
