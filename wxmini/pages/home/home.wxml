<view class="home-page">
  <view class="home-nav">
    <view class="home-nav-city">📍 北京</view>
    <view class="home-nav-title">{{appName}}</view>
    <view class="home-nav-msg">💬</view>
  </view>

  <view class="home-search">
    <van-search
      value="{{searchKeyword}}"
      placeholder="搜索银行名称"
      bind:search="onSearch"
      bind:clear="onSearchClear"
      background="#fff"
    />
  </view>

  <!-- Skeleton -->
  <view wx:if="{{loading && staffList.length === 0}}">
    <skeleton-card showImage="{{true}}"></skeleton-card>
    <skeleton-list count="4"></skeleton-list>
  </view>

  <block wx:else>
    <!-- 业务范围筛选 -->
    <view class="scope-filter-bar">
      <view
        class="scope-filter-tag {{item.checked ? 'active' : ''}}"
        wx:for="{{scopeFilterTags}}"
        wx:key="name"
        data-name="{{item.name}}"
        bindtap="onScopeFilterTap"
      >{{item.name}}</view>
    </view>

    <!-- 推荐银行人员 –垂直卡片列表 -->
    <view class="staff-list">
      <view
        class="staff-card"
        wx:for="{{staffList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onStaffTap"
      >
        <view class="card-main">
          <view class="avatar avatar-sm">{{(item.nickname && item.nickname[0]) || '银'}}</view>
          <view class="card-info">
            <view class="info-row">
              <text class="staff-name">{{item.nickname || item.username}}</text>
              <status-tag status="1" type="audit"></status-tag>
            </view>
            <view class="info-sub">{{item.bank_name || '中国银行'}} · {{item.position || '客户经理'}}</view>
            <view class="scope-tags" wx:if="{{item.business_scope}}">
              <van-tag
                wx:for="{{item.business_scope.split(',')}}"
                wx:for-item="scope"
                wx:key="*this"
                color="#DBEAFE"
                text-color="#2563EB"
                size="small"
              >{{scope}}</van-tag>
            </view>
          </view>
        </view>
        
        <view class="card-actions">
          <view class="action-btn btn-phone" catchtap="onCallPhone" data-phone="{{item.phone}}">
            <van-icon name="phone-o" size="20px" color="#fff" />
          </view>
          <view class="action-btn btn-chat" catchtap="onChat" data-id="{{item.id}}" data-name="{{item.nickname || item.username}}">
            <van-icon name="chat-o" size="20px" color="#fff" />
          </view>
        </view>
      </view>
    </view>

    <view class="load-more" wx:if="{{loadingMore}}">加载中...</view>
    <view class="load-more" wx:if="{{!hasMore && staffList.length > 0}}">没有更多了</view>
    <view class="empty-tip" wx:if="{{!loading && staffList.length === 0}}">暂无符合条件的银行人员</view>
  </block>
</view>
