<view class="page-container">
  <!-- 银行区域 -->
  <view class="section-block">
    <view class="section-header">
      <text class="section-icon">🏦</text>
      <text class="section-title">银行</text>
    </view>

    <!-- 子TAB -->
    <scroll-view class="status-tabs-scroll" scroll-x enhanced show-scrollbar="false">
      <view class="status-tabs">
        <view
          class="status-tab {{bank.activeStatus === item.value ? 'status-tab-active' : ''}}"
          wx:for="{{statusTabs}}"
          wx:key="value"
          data-section="bank"
          data-status="{{item.value}}"
          bindtap="onStatusTap"
        >
          <text class="status-tab-icon">{{item.icon}}</text>
          <text class="status-tab-label">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 列表 -->
    <view class="audit-list">
      <van-loading wx:if="{{bank.loading && bank.list.length === 0}}" size="24px" vertical>加载中...</van-loading>

      <block wx:elif="{{bank.list.length > 0}}">
        <view
          class="audit-card"
          wx:for="{{bank.list}}"
          wx:key="id"
          data-user-id="{{item.id}}"
          data-role="{{item.user_type}}"
          bindtap="onCardTap"
        >
          <view class="card-avatar-wrapper">
            <image wx:if="{{item.head_image}}" class="card-avatar" src="{{item.head_image}}" mode="aspectFill" lazy-load />
            <view wx:else class="card-avatar card-avatar-default">{{item._avatarText}}</view>
          </view>
          <view class="card-info">
            <view class="info-header">
              <view class="info-name">{{item.nickname || item.real_name || item.username || '未知'}}</view>
              <van-tag color="{{item._auditStatusColor}}" text-color="#fff" size="medium">{{item._auditStatusText}}</van-tag>
            </view>
            <view class="info-phone" catchtap="onPhoneTap" data-phone="{{item.phone}}">
              <van-icon name="phone-o" size="14px" color="#2563EB" />
              <text class="phone-text">{{item.phone || '-'}}</text>
            </view>
          </view>
          <view class="card-action" catchtap="onAuditBtnTap">
            <van-button wx:if="{{item.audit_status === 'under_review'}}" size="small" round type="primary" icon="passed" bind:click="onAuditTap" data-user-id="{{item.id}}" data-role="{{item.user_type}}">审核</van-button>
          </view>
        </view>

        <view wx:if="{{bank.hasMore}}" class="load-more-wrap">
          <van-button size="small" plain type="primary" bind:click="onLoadMore" data-section="bank">加载更多</van-button>
        </view>
        <view wx:elif="{{bank.list.length > 0}}" class="load-more-text">没有更多了</view>
      </block>

      <van-empty wx:else description="暂无数据" />
    </view>
  </view>

  <!-- 企业区域 -->
  <view class="section-block">
    <view class="section-header">
      <text class="section-icon">🏢</text>
      <text class="section-title">企业</text>
    </view>

    <!-- 子TAB -->
    <scroll-view class="status-tabs-scroll" scroll-x enhanced show-scrollbar="false">
      <view class="status-tabs">
        <view
          class="status-tab {{company.activeStatus === item.value ? 'status-tab-active' : ''}}"
          wx:for="{{statusTabs}}"
          wx:key="value"
          data-section="company"
          data-status="{{item.value}}"
          bindtap="onStatusTap"
        >
          <text class="status-tab-icon">{{item.icon}}</text>
          <text class="status-tab-label">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 列表 -->
    <view class="audit-list">
      <van-loading wx:if="{{company.loading && company.list.length === 0}}" size="24px" vertical>加载中...</van-loading>

      <block wx:elif="{{company.list.length > 0}}">
        <view
          class="audit-card"
          wx:for="{{company.list}}"
          wx:key="id"
          data-user-id="{{item.id}}"
          data-role="{{item.user_type}}"
          bindtap="onCardTap"
        >
          <view class="card-avatar-wrapper">
            <image wx:if="{{item.head_image}}" class="card-avatar" src="{{item.head_image}}" mode="aspectFill" lazy-load />
            <view wx:else class="card-avatar card-avatar-default">{{item._avatarText}}</view>
          </view>
          <view class="card-info">
            <view class="info-header">
              <view class="info-name">{{item.nickname || item.real_name || item.username || '未知'}}</view>
              <van-tag color="{{item._auditStatusColor}}" text-color="#fff" size="medium">{{item._auditStatusText}}</van-tag>
            </view>
            <view class="info-phone" catchtap="onPhoneTap" data-phone="{{item.phone}}">
              <van-icon name="phone-o" size="14px" color="#2563EB" />
              <text class="phone-text">{{item.phone || '-'}}</text>
            </view>
          </view>
          <view class="card-action" catchtap="onAuditBtnTap">
            <van-button wx:if="{{item.audit_status === 'under_review'}}" size="small" round type="primary" icon="passed" bind:click="onAuditTap" data-user-id="{{item.id}}" data-role="{{item.user_type}}">审核</van-button>
          </view>
        </view>

        <view wx:if="{{company.hasMore}}" class="load-more-wrap">
          <van-button size="small" plain type="primary" bind:click="onLoadMore" data-section="company">加载更多</van-button>
        </view>
        <view wx:elif="{{company.list.length > 0}}" class="load-more-text">没有更多了</view>
      </block>

      <van-empty wx:else description="暂无数据" />
    </view>
  </view>
</view>
