.card-list {
  padding: 24rpx;
}

.company-card {
  background-color: #fff;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.15s ease;
}

.company-card:active {
  transform: scale(0.98);
}

.card-header {
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--van-border-color);
}

.company-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--van-text-color);
  margin-bottom: 8rpx;
}

.company-code {
  font-size: 24rpx;
  color: var(--van-text-color-2);
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-row-company {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.info-text {
  font-size: 26rpx;
  color: var(--van-text-color-2);
}

.card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--van-border-color);
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  background-color: #F3F4F6;
}

.action-btn:active {
  opacity: 0.8;
}

.action-text {
  font-size: 26rpx;
  color: var(--van-text-color);
}
