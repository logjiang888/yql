.detail-header {
  background: linear-gradient(180deg, #DBEAFE 0%, var(--van-background-color) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 40rpx;
}

.detail-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--van-text-color);
  margin-top: 20rpx;
  margin-bottom: 12rpx;
}

.detail-status {
  margin-bottom: 12rpx;
}

.detail-bank {
  font-size: 28rpx;
  color: var(--van-text-color-2);
}

.card-section {
  padding: 24rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--van-text-color);
  margin-bottom: 24rpx;
  padding-left: 20rpx;
  position: relative;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background-color: var(--van-primary-color);
  border-radius: 3rpx;
}

/* 底部操作栏*/
.detail-footer {
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}

.footer-actions {
  display: flex;
  gap: 24rpx;
}

.footer-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.15s ease;
}

.footer-btn:active {
  transform: scale(0.97);
}

.btn-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
}

.btn-phone-secondary {
  background: linear-gradient(135deg, #2563EB, #3B82F6);
}

.btn-chat-secondary {
  background: linear-gradient(135deg, #10B981, #34D399);
}

.product-text {
  font-size: 28rpx;
  color: var(--van-text-color-2);
  line-height: 1.6;
  padding-left: 20rpx;
}

.proof-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-left: 20rpx;
}

.proof-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
}
