.profile-header {
  background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx 80rpx;
}

.profile-header .avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 600;
  color: #fff;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
}

.profile-role {
  margin-bottom: 12rpx;
}

.profile-role .scope-tag {
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.profile-phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.menu-card {
  margin: -40rpx 32rpx 0;
  position: relative;
  z-index: 1;
  padding: 8rpx 0;
  border-radius: 24rpx 24rpx 16rpx 16rpx;
}

/* 编辑模式 */
.edit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background-color: #fff;
  border-bottom: 2rpx solid var(--van-border-color);
}

.edit-back {
  font-size: 30rpx;
  color: var(--van-text-color-2);
}

.edit-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--van-text-color);
}

.edit-save {
  font-size: 30rpx;
  color: var(--van-primary-color);
  font-weight: 500;
}

.edit-section {
  background-color: #fff;
  margin-bottom: 24rpx;
  padding: 24rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--van-text-color);
  margin-bottom: 24rpx;
  padding-left: 32rpx;
  position: relative;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background-color: var(--van-primary-color);
  border-radius: 3rpx;
}

.edit-footer {
  padding: 32rpx;
  background-color: #fff;
}

.mt-md {
  margin-top: 24rpx;
}

/* 银行联行号选择器 */
.bank-code-row {
  display: flex;
  align-items: center;
}

.bank-code-field {
  flex: 1;
}

.search-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  height: 88rpx;
}

.bank-selected-info {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  color: var(--van-text-color-2);
  background-color: #f7f8fa;
}

.bank-selected-label {
  color: var(--van-text-color-3);
}

.bank-selected-name {
  color: var(--van-primary-color);
  font-weight: 500;
}

.bank-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--van-border-color);
}

.bank-picker-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--van-text-color);
}

.bank-picker-subtitle {
  font-size: 26rpx;
  color: var(--van-text-color-3);
  padding: 16rpx 32rpx 0;
}

.bank-picker-list {
  max-height: 800rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.bank-picker-item {
  position: relative;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background-color: #fff;
  transition: background-color 0.2s;
}

.bank-picker-item:active {
  background-color: var(--van-active-color);
}

.bank-picker-item-active {
  background-color: var(--van-primary-color-light, #ecf5ff);
}

.bank-picker-name {
  font-size: 30rpx;
  color: var(--van-text-color);
  margin-bottom: 8rpx;
  padding-right: 60rpx;
}

.bank-picker-code {
  font-size: 26rpx;
  color: var(--van-text-color-3);
}

.bank-picker-check {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
}

.bank-picker-empty {
  padding: 60rpx 0;
}

/* 业务范围标签 */
.scope-section {
  margin: 0 32rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.scope-section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #323233;
  padding: 24rpx 32rpx 16rpx;
}

.scope-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx 32rpx 24rpx;
  background-color: #fff;
}

.scope-tag {
  display: inline-flex;
  align-items: center;
  position: relative;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  border: 2rpx solid #ebedf0;
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
}

.scope-tag-hover {
  opacity: 0.7;
}

.scope-active {
  background-color: #2563EB;
  color: #fff;
  border-color: #2563EB;
}

.scope-check-icon {
  margin-left: 8rpx;
}
