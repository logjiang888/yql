<view class="chat-page">
  <!-- 顶部对方信息栏 -->
  <view class="chat-header">
    <view class="chat-header-left">
      <image wx:if="{{toUserHeadImage}}" class="chat-header-avatar" src="{{toUserHeadImage}}" mode="aspectFill" />
      <view wx:else class="chat-header-avatar chat-header-avatar-text">{{toUserName[0]}}</view>
      <view class="chat-header-info">
        <view class="chat-header-name">{{toUserName}}</view>
        <view wx:if="{{toUserTypeText}}" class="chat-header-role">{{toUserTypeIcon}}{{toUserTypeText}}</view>
      </view>
    </view>
    <view class="chat-header-actions">
      <view class="header-action-btn" bindtap="onViewDetail">
        <van-icon name="eye-o" size="14px" color="#2563EB" />
        <text class="header-action-text">查看详情</text>
      </view>
      <view wx:if="{{toUserType === 'company'}}" class="header-action-btn header-action-primary" bindtap="onAddIntention">
        <van-icon name="plus" size="14px" color="#fff" />
        <text class="header-action-text">意向客户</text>
      </view>
    </view>
  </view>

  <scroll-view
    class="chat-messages"
    scroll-y
    scroll-into-view="{{scrollToId}}"
    scroll-with-animation
  >
    <view
      class="message-item {{item.fromId === toUserId ? 'left' : 'right'}}"
      wx:for="{{messages}}"
      wx:key="id"
      id="msg_{{item.id}}"
    >
      <view class="msg-avatar-wrap" wx:if="{{item.fromId === toUserId}}">
        <image wx:if="{{toUserHeadImage}}" class="msg-avatar" src="{{toUserHeadImage}}" mode="aspectFill" />
        <view wx:else class="msg-avatar">{{toUserName[0]}}</view>
      </view>

      <view class="msg-content">
        <view class="msg-bubble">{{item.content}}</view>
        <view class="msg-time">{{formatTime(item.createTime)}}</view>
      </view>
    </view>

    <view class="chat-empty" wx:if="{{messages.length === 0}}">
      <text class="text-secondary">开始聊天吧~</text>
    </view>
  </scroll-view>

  <view class="chat-input-bar">
    <input
      class="chat-input"
      placeholder="输入消息..."
      value="{{inputValue}}"
      confirm-type="send"
      bindconfirm="onSend"
      bindinput="onInputChange"
    />
    <van-button
      size="small"
      type="primary"
      disabled="{{!canSend}}"
      bind:click="onSend"
      custom-class="send-btn"
    >发送</van-button>
  </view>
</view>
