.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--van-background-color);
}

.chat-messages {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.message-item {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
}

.message-item.left {
  flex-direction: row;
}

.message-item.right {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  background-color: var(--primary-light);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--van-primary-color);
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.message-item.right .msg-avatar {
  margin-right: 0;
  margin-left: 20rpx;
}

.msg-content {
  max-width: 70%;
}

.msg-bubble {
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-break: break-all;
}

.message-item.left .msg-bubble {
  background-color: #fff;
  color: var(--van-text-color);
  border-bottom-left-radius: 4rpx;
}

.message-item.right .msg-bubble {
  background-color: var(--van-primary-color);
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.msg-time {
  font-size: 20rpx;
  color: var(--van-text-color-3);
  margin-top: 8rpx;
}

.message-item.left .msg-time {
  text-align: left;
}

.message-item.right .msg-time {
  text-align: right;
}

.chat-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  color: var(--van-text-color-3);
  font-size: 28rpx;
}

.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  border-top: 2rpx solid var(--van-border-color);
}

.chat-input {
  flex: 1;
  height: 80rpx;
  background-color: var(--van-background-color);
  border-radius: var(--radius-full);
  padding: 0 28rpx;
  font-size: 30rpx;
  color: var(--van-text-color);
}

.send-btn {
  margin-left: 16rpx !important;
  height: 72rpx !important;
}
