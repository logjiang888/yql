<view class="page-white">
  <!-- 顶部标题 -->
  <view class="register-header">
    <view class="register-title">注册账号</view>
    <view class="register-subtitle">请选择用户类型并填写基本信息</view>
  </view>

  <!-- 用户类型选择 -->
  <view class="type-section">
    <view class="section-label">用户类型</view>
    <view class="type-grid">
      <view
        class="type-card {{ role === 'company' ? 'type-active' : '' }}"
        data-role="company"
        bindtap="onRoleChange"
      >
        <view class="type-icon">🏢</view>
        <view class="type-name">企业客户</view>
        <view class="type-desc">贷款需求方</view>
      </view>
      <view
        class="type-card {{ role === 'bank' ? 'type-active' : '' }}"
        data-role="bank"
        bindtap="onRoleChange"
      >
        <view class="type-icon">🏦</view>
        <view class="type-name">银行人员</view>
        <view class="type-desc">贷款提供方</view>
      </view>
      <view
        class="type-card {{ role === 'plat_salesperson' ? 'type-active' : '' }}"
        data-role="plat_salesperson"
        bindtap="onRoleChange"
      >
        <view class="type-icon">🤝</view>
        <view class="type-name">业务员</view>
        <view class="type-desc">居间服务方</view>
      </view>
    </view>
  </view>

  <!-- 表单 -->
  <view class="form-section">
    <van-cell-group inset>
      <van-field
        value="{{ form.phone }}"
        label="手机号码"
        placeholder="请输入手机号码"
        type="number"
        maxlength="11"
        required
        data-field="phone"
        bind:input="onInputChange"
        error="{{ errorField === 'phone' }}"
        left-icon="phone-o"
      />
      <van-field
        value="{{ form.password }}"
        label="登录密码"
        placeholder="请设置登录密码（不少于6位）"
        password
        required
        data-field="password"
        bind:input="onInputChange"
        error="{{ errorField === 'password' }}"
        left-icon="lock"
      />
      <van-field
        value="{{ form.confirm_password }}"
        label="确认密码"
        placeholder="请再次输入密码"
        password
        required
        data-field="confirm_password"
        bind:input="onInputChange"
        error="{{ errorField === 'confirm_password' }}"
        left-icon="passed"
      />
    </van-cell-group>

    <!-- 协议 -->
    <view class="protocol-row">
      <van-checkbox
        value="{{ agreed }}"
        icon-size="36rpx"
        bind:change="onToggleAgree"
        checked-color="#2563EB"
      ></van-checkbox>
      <view class="protocol-text">
        我已阅读并同意<text class="text-primary" bindtap="onTapProtocol">《用户注册协议》</text>
      </view>
    </view>

    <!-- 提交按钮 -->
    <van-button
      type="primary"
      block
      round
      size="large"
      bind:click="onSubmit"
      custom-class="submit-btn"
    >提交注册</van-button>

    <!-- 底部提示 -->
    <view class="bottom-tip">
      已有账号？<text class="text-primary" bindtap="onGoLogin">去登录</text>
    </view>
  </view>

  <!-- 注册成功提示弹窗 -->
  <van-popup
    show="{{ showAuditPopup }}"
    round
    closeable
    bind:close="onCloseAuditPopup"
    custom-class="audit-popup"
  >
    <view class="audit-content">
      <view class="audit-icon">🎉</view>
      <view class="audit-title">恭喜您，注册成功！</view>
      <view class="audit-desc">
        为了给您提供更精准、更优质的服务，建议您尽快完善个人资料。
      </view>
      <view class="audit-path">
        <text class="audit-path-label">完善路径：</text>
        <text class="audit-path-highlight">我的 → 个人资料</text>
      </view>
      <view class="audit-hint">
        资料越完整，匹配越精准，服务更高效
      </view>
      <van-button
        type="primary"
        block
        round
        bind:click="onGoLogin"
        custom-class="audit-btn"
      >立即去完善</van-button>
    </view>
  </van-popup>

  <van-toast id="van-toast" />
</view>
