/* 页面背景 */
.page-white {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: 48rpx;
}

/* 顶部标题 */
.register-header {
  text-align: center;
  padding: 48rpx 32rpx 32rpx;
}

.register-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.register-subtitle {
  font-size: 28rpx;
  color: #999;
}

/* 用户类型选择 */
.type-section {
  margin: 0 32rpx 32rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #323233;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.type-grid {
  display: flex;
  gap: 20rpx;
}

.type-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #fff;
  border: 2rpx solid #ebedf0;
  border-radius: 16rpx;
  padding: 28rpx 0;
  transition: all 0.2s;
}

.type-card:active {
  opacity: 0.8;
}

.type-active {
  background-color: #2563EB;
  border-color: #2563EB;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.type-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #323233;
  margin-bottom: 4rpx;
}

.type-active .type-name {
  color: #fff;
}

.type-desc {
  font-size: 22rpx;
  color: #999;
}

.type-active .type-desc {
  color: rgba(255, 255, 255, 0.8);
}

/* 表单区 */
.form-section {
  margin: 0 32rpx;
}

/* 协议 */
.protocol-row {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding: 0 8rpx;
}

.protocol-text {
  font-size: 26rpx;
  color: #666;
  margin-left: 12rpx;
}

.text-primary {
  color: #2563EB;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 40rpx !important;
}

/* 底部提示 */
.bottom-tip {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  margin-top: 32rpx;
}

/* 审核弹窗 */
.audit-popup {
  width: 600rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.audit-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 40rpx 40rpx;
}

.audit-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.audit-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.audit-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.audit-path {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #bfdbfe;
}

.audit-path-label {
  font-size: 26rpx;
  color: #4b5563;
}

.audit-path-highlight {
  font-size: 28rpx;
  font-weight: 600;
  color: #2563EB;
  margin-left: 8rpx;
}

.audit-hint {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.audit-btn {
  width: 100%;
}
