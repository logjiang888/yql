.map-preview {
  position: relative;
  height: 400rpx;
}

.detail-map {
  width: 100%;
  height: 100%;
}

.nav-float-btn {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  width: 96rpx;
  height: 96rpx;
  background-color: var(--van-primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(25, 137, 250, 0.3);
}
