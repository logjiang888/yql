.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #fff;
  display: flex;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
  z-index: 999;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9CA3AF;
  transition: color 0.2s ease;
  position: relative;
  padding-top: 8rpx;
}

.tab-bar-item.active {
  color: #2563EB;
}

.tab-icon {
  margin-bottom: 8rpx;
  line-height: 1;
  transition: transform 0.2s ease;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-image {
  width: 48rpx;
  height: 48rpx;
}

.tab-bar-item.active .tab-icon {
  transform: scale(1.08);
}

.tab-text {
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 400;
  transition: font-weight 0.2s ease;
}

.tab-bar-item.active .tab-text {
  font-weight: 500;
}
